# Supabase (docs/architecture.md §3, §7) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only — never expose to the browser. Used by the
# internal scrape ingestion route and any admin-level operation.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scraping worker presents to authenticate against
# POST /internal/v1/scrape-results (docs/api.md "Internal" section).
INTERNAL_API_TOKEN=

# Stripe (docs/api.md "Billing" section, Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Base URL of this deployment, used to build Stripe redirect URLs.
# e.g. http://localhost:3000 in development, https://gowild.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
